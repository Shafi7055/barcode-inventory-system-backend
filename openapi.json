{
  "openapi": "3.1.0",
  "info": {
    "title": "Barcode Inventory API",
    "version": "1.0.0",
    "description": "Local-development REST contract with cookie-based sessions and server-enforced role authorization. The API must not be exposed to a network."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4001/api/v1",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Dashboard"
    },
    {
      "name": "Inventory"
    },
    {
      "name": "Master data"
    },
    {
      "name": "Reports"
    },
    {
      "name": "Administration"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Sign in and create a session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {"type": "string"},
                  "password": {"type": "string", "format": "password"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Signed in; sets an HttpOnly session cookie"},
          "401": {"description": "Invalid credentials"}
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a read-only Report Viewer",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "username", "password"],
                "properties": {
                  "name": {"type": "string"},
                  "username": {"type": "string"},
                  "password": {"type": "string", "format": "password", "minLength": 12}
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Report Viewer account created"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "422": {"$ref": "#/components/responses/ValidationError"}
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Revoke the current session",
        "responses": {"204": {"description": "Signed out"}}
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Get the signed-in user and role",
        "responses": {"200": {"description": "Current account"}}
      }
    },
    "/auth/password": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Change the current account password and revoke sessions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": {"type": "string", "format": "password"},
                  "newPassword": {"type": "string", "format": "password", "minLength": 12}
                }
              }
            }
          }
        },
        "responses": {"204": {"description": "Password changed"}}
      }
    },
    "/users": {
      "get": {
        "tags": ["Administration"],
        "summary": "List users (Admin)",
        "responses": {"200": {"description": "User accounts"}}
      },
      "post": {
        "tags": ["Administration"],
        "summary": "Create a user (Admin)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "username", "password", "role"],
                "properties": {
                  "name": {"type": "string"},
                  "username": {"type": "string"},
                  "password": {"type": "string", "format": "password", "minLength": 12},
                  "role": {"type": "string", "enum": ["Admin", "Component Tracker", "Receive User", "Delivery User", "Report Viewer"]}
                }
              }
            }
          }
        },
        "responses": {"201": {"description": "User created"}}
      }
    },
    "/users/roles": {
      "get": {
        "tags": ["Administration"],
        "summary": "List the fixed user roles (Admin)",
        "responses": {"200": {"description": "Available roles"}}
      }
    },
    "/users/{userId}": {
      "patch": {
        "tags": ["Administration"],
        "summary": "Update a user role, active state, name, or password (Admin)",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {"type": "integer", "minimum": 1}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "role": {"type": "string", "enum": ["Admin", "Component Tracker", "Receive User", "Delivery User", "Report Viewer"]},
                  "isActive": {"type": "boolean"},
                  "password": {"type": "string", "format": "password", "minLength": 12}
                }
              }
            }
          }
        },
        "responses": {"200": {"description": "User updated"}}
      }
    },
    "/dashboard": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Get dashboard metrics and recent movements",
        "responses": {
          "200": {
            "description": "Dashboard data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "itemsInStock",
                        "receivedToday",
                        "deliveredToday",
                        "recentMovements"
                      ],
                      "properties": {
                        "itemsInStock": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "receivedToday": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "deliveredToday": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "recentMovements": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Movement"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "Master data"
        ],
        "summary": "List products",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Product page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Master data"
        ],
        "summary": "Create a product",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "code"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/components": {
      "get": {
        "tags": [
          "Master data"
        ],
        "summary": "List components",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Component page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComponentPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Master data"
        ],
        "summary": "Create a component",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "code",
                  "barcode"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "barcode": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created component",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Component"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/stock-points": {
      "get": {
        "tags": [
          "Master data"
        ],
        "summary": "List active receive or delivery points",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "RECEIVE",
                "DELIVERY"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching stock points",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StockPoint"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Master data"
        ],
        "summary": "Create a receive or delivery point",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "RECEIVE",
                      "DELIVERY"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created stock point",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/StockPoint"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/component-tracking": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Track a component on a product unit",
        "description": "Register the unit as pending receipt when first scanned, then attach its component before the unit is received.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "productBarcode",
                  "componentBarcode"
                ],
                "properties": {
                  "productBarcode": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}-[0-9]{8}$",
                    "example": "FRG-00000120"
                  },
                  "componentBarcode": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}-[A-Z]{3}-[0-9]{8}$",
                    "example": "FRG-CMP-00000120"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Component association created; unit remains pending receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "unitId",
                        "productBarcode",
                        "componentBarcode",
                        "createdAt"
                      ],
                      "properties": {
                        "unitId": {
                          "type": "integer"
                        },
                        "productBarcode": {
                          "type": "string"
                        },
                        "componentBarcode": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/receipts": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Receive an item",
        "description": "Record a receipt and inventory transaction atomically. Accepts an optional Idempotency-Key header.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "barcode",
                  "pointId"
                ],
                "properties": {
                  "barcode": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}-[0-9]{8}$",
                    "example": "FRG-00000120"
                  },
                  "pointId": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "productId": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional legacy compatibility field; product is determined from the registered unit."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Receipt recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Movement"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/deliveries": {
      "post": {
        "tags": [
          "Inventory"
        ],
        "summary": "Deliver an item",
        "description": "Record a delivery and inventory transaction atomically. Accepts an optional Idempotency-Key header.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "barcode",
                  "pointId"
                ],
                "properties": {
                  "barcode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointId": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Delivery recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Movement"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/transactions/{transactionId}/reversals": {
      "post": {
        "tags": [
          "Inventory",
          "Administration"
        ],
        "summary": "Reverse an inventory transaction",
        "description": "Creates a reversal transaction linked to the original; it does not delete or rewrite history.",
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reversal recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Movement"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/reports/stock-details": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get current stock by product instance",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "IN_STOCK",
                "DELIVERED"
              ]
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stock page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockPage"
                }
              }
            }
          }
        }
      }
    },
    "/reports/summary": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Summarize inventory transactions for a date range",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "timeZone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "UTC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Summary for the inclusive date range",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "from",
                        "to",
                        "received",
                        "delivered",
                        "reversed"
                      ],
                      "properties": {
                        "from": {
                          "type": "string",
                          "format": "date"
                        },
                        "to": {
                          "type": "string",
                          "format": "date"
                        },
                        "received": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "delivered": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "reversed": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/reports/barcode-history": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get movement history for a barcode",
        "parameters": [
          {
            "name": "barcode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chronological barcode history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Movement"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/audit-logs": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List audit log entries",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit log page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLogPage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "inventory_session"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Unique per logical write request; replaying the same key returns the original result.",
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      }
    },
